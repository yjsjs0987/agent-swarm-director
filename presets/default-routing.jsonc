// ASD v2.3 default model routing preset.
// Bootstrapped to ~/.asd/routing.jsonc on first use; per-project
// overrides live in <project>/.asd/routing.jsonc (1st priority).
// 5 core agent roles (planner, architect, worker, scout, critic) +
// domain categories & 3 difficulty tiers (low, medium, high).
{
  "_asdVersion": "2.3.0",
  "agents": {
    "planner": {
      "harness": "claude-code",
      "model": "claude-sonnet-4-6",
      "modelFamily": "claude",
      "fallbacks": [
        { "harness": "codex", "model": "gpt-5-codex", "modelFamily": "gpt" },
        { "harness": "opencode", "model": "glm-5", "modelFamily": "glm" }
      ]
    },
    "architect": {
      "harness": "claude-code",
      "model": "claude-opus-4-6",
      "modelFamily": "claude",
      "fallbacks": [
        { "harness": "codex", "model": "gpt-5-codex", "modelFamily": "gpt" },
        { "harness": "opencode", "model": "glm-5", "modelFamily": "glm" }
      ]
    },
    "worker": {
      "harness": "opencode",
      "model": "glm-5",
      "modelFamily": "glm",
      "fallbacks": [
        { "harness": "codex", "model": "gpt-5-codex", "modelFamily": "gpt" },
        { "harness": "antigravity", "model": "gemini-3-flash", "modelFamily": "gemini" }
      ]
    },
    "scout": {
      "harness": "antigravity",
      "model": "gemini-3-flash-lite",
      "modelFamily": "gemini",
      "fallbacks": [
        { "harness": "codex", "model": "gpt-5-codex", "modelFamily": "gpt" },
        { "harness": "opencode", "model": "glm-5", "modelFamily": "glm" }
      ]
    },
    "critic": {
      "harness": "codex",
      "model": "gpt-5-codex",
      "modelFamily": "gpt",
      "fallbacks": [
        { "harness": "claude-code", "model": "claude-opus-4-6", "modelFamily": "claude" },
        { "harness": "opencode", "model": "glm-5", "modelFamily": "glm" }
      ]
    }
  },
  "categories": {
    "visual-ui": {
      "harness": "claude-code",
      "model": "claude-sonnet-4-6",
      "modelFamily": "claude",
      "fallbacks": [
        { "harness": "antigravity", "model": "gemini-3-pro", "modelFamily": "gemini" },
        { "harness": "opencode", "model": "glm-5", "modelFamily": "glm" }
      ]
    },
    "design": {
      "harness": "claude-code",
      "model": "claude-sonnet-4-6",
      "modelFamily": "claude",
      "fallbacks": [
        { "harness": "antigravity", "model": "gemini-3-pro", "modelFamily": "gemini" },
        { "harness": "opencode", "model": "glm-5", "modelFamily": "glm" }
      ]
    },
    "research": {
      "harness": "opencode",
      "model": "deepseek-r1",
      "modelFamily": "deepseek",
      "fallbacks": [
        { "harness": "codex", "model": "gpt-5-codex", "modelFamily": "gpt" },
        { "harness": "claude-code", "model": "claude-sonnet-4-6", "modelFamily": "claude" }
      ]
    },
    "writing": {
      "harness": "codex",
      "model": "gpt-5-codex",
      "modelFamily": "gpt",
      "fallbacks": [
        { "harness": "claude-code", "model": "claude-sonnet-4-6", "modelFamily": "claude" },
        { "harness": "opencode", "model": "glm-5", "modelFamily": "glm" }
      ]
    },
    "general": {
      "harness": "opencode",
      "model": "glm-5",
      "modelFamily": "glm",
      "fallbacks": [
        { "harness": "codex", "model": "gpt-5-codex", "modelFamily": "gpt" },
        { "harness": "antigravity", "model": "gemini-3-flash", "modelFamily": "gemini" }
      ]
    },
    "low": {
      "harness": "antigravity",
      "model": "gemini-3-flash",
      "modelFamily": "gemini",
      "fallbacks": [
        { "harness": "codex", "model": "gpt-5-codex", "modelFamily": "gpt" },
        { "harness": "opencode", "model": "glm-5", "modelFamily": "glm" }
      ]
    },
    "medium": {
      "harness": "opencode",
      "model": "glm-5",
      "modelFamily": "glm",
      "fallbacks": [
        { "harness": "codex", "model": "gpt-5-codex", "modelFamily": "gpt" },
        { "harness": "claude-code", "model": "claude-sonnet-4-6", "modelFamily": "claude" }
      ]
    },
    "high": {
      "harness": "claude-code",
      "model": "claude-sonnet-4-6",
      "modelFamily": "claude",
      "fallbacks": [
        { "harness": "codex", "model": "gpt-5-codex", "modelFamily": "gpt" },
        { "harness": "opencode", "model": "glm-5", "modelFamily": "glm" }
      ]
    }
  }
}
